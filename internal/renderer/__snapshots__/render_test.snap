[TestRenderMarkdown_InlineCode - 1]
<p>Use <code>fmt.Println</code> to print output.</p>

---

[TestRenderToolUseBlock - 1]
<details class="collapsible tool-use" style="--preview-lines: 5;"><summary><span class="tool-icon">$</span> <span class="tool-name">Bash</span> <span class="tool-arg">echo hello world</span></summary><div class="preview-content"><pre class="chroma"><code><span class="line"><span class="cl"><span class="nb">echo</span> hello world</span></span></code></pre></div></details>
