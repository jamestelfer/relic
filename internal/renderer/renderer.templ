package renderer

import (
	"fmt"
	"time"

	"github.com/jamestelfer/relic/internal/ansi"
	"github.com/jamestelfer/relic/internal/parser"
)

// page renders a complete, minimal HTML document for a session.
templ page(name, filePath string, start *time.Time, turns []Turn, theme string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ name } — relic</title>
			<style>
				body { font-family: sans-serif; max-width: 900px; margin: 0 auto; padding: 1rem; }
				.session-banner { border-bottom: 2px solid #ccc; margin-bottom: 1.5rem; padding-bottom: 1rem; }
				.session-banner dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; }
				section[id^="turn-"] { border-left: 3px solid #e0e0e0; margin: 1rem 0; padding-left: 1rem; }
				.message { margin-bottom: 1rem; }
				.message-header { display: flex; gap: 1rem; font-size: 0.85em; color: #666; margin-bottom: 0.25rem; }
				.message-role { font-weight: bold; text-transform: capitalize; }
				.message-time { font-style: italic; }
				.message-user .message-role { color: #1a73e8; }
				.message-assistant .message-role { color: #188038; }
				.message-body { padding-left: 0.5rem; }
				.text-block { margin: 0.25rem 0; }
				.raw-block { background: #f5f5f5; padding: 0.5rem; overflow-x: auto; font-size: 0.85em; }
				.error-callout { border-left: 4px solid #d93025; background: #fce8e6; padding: 0.5rem 0.75rem; margin: 0.5rem 0; font-size: 0.9em; }
				details.collapsible > .preview-content { max-height: calc(1.5em * var(--preview-lines, 5)); overflow: hidden; }
				details.collapsible[open] > .preview-content { max-height: none; }
				.toc { background: #f9f9f9; border: 1px solid #ddd; padding: 0.75rem 1rem; margin-bottom: 1.5rem; display: inline-block; min-width: 20rem; }
				.toc h2 { margin: 0 0 0.5rem; font-size: 1rem; }
				.toc ol { margin: 0; padding-left: 1.25rem; }
				.toc li { margin: 0.2rem 0; }
				.turn-nav { display: flex; gap: 1rem; font-size: 0.85em; margin-bottom: 0.5rem; }
				.jk-nav a { display: none; }
				section:target .jk-nav a { display: inline; }
			</style>
			<script>
				document.addEventListener('DOMContentLoaded', function() {
					document.querySelectorAll('pre').forEach(function(pre) {
						var btn = document.createElement('button');
						btn.textContent = 'Copy';
						btn.style.cssText = 'position:absolute;top:0.25rem;right:0.25rem;font-size:0.75em;padding:0.1rem 0.4rem;cursor:pointer;';
						pre.style.position = 'relative';
						btn.addEventListener('click', function() {
							navigator.clipboard.writeText(pre.querySelector('code') ? pre.querySelector('code').innerText : pre.innerText);
							btn.textContent = 'Copied!';
							setTimeout(function(){ btn.textContent = 'Copy'; }, 1500);
						});
						pre.appendChild(btn);
					});
				});
			</script>
			@chromaStyleComponent()
		</head>
		<body>
			@banner(name, filePath, start, len(turns))
			@toc(turns)
			<main>
				for _, turn := range turns {
					@turnSection(turn, start, len(turns), theme)
				}
			</main>
		</body>
	</html>
}

// banner renders the session summary header.
templ banner(name, filePath string, firstDate *time.Time, turnCount int) {
	<header class="session-banner">
		<h1>{ name }</h1>
		<dl>
			<dt>File</dt>
			<dd>{ filePath }</dd>
			if firstDate != nil {
				<dt>Date</dt>
				<dd>{ firstDate.UTC().Format(time.RFC1123) }</dd>
			}
			<dt>Turns</dt>
			<dd>{ fmt.Sprintf("%d", turnCount) }</dd>
		</dl>
	</header>
}

// toc renders the table of contents: one entry per turn.
templ toc(turns []Turn) {
	<nav class="toc">
		<h2>Contents</h2>
		<ol>
			for _, turn := range turns {
				<li><a href={ templ.SafeURL("#turn-" + fmt.Sprintf("%d", turn.Index)) }>{ tocLabel(turn) }</a></li>
			}
		</ol>
	</nav>
}

// turnSection renders a single turn (user + following assistant messages) in a labelled section.
templ turnSection(turn Turn, start *time.Time, total int, theme string) {
	<section id={ fmt.Sprintf("turn-%d", turn.Index) }>
		<nav class="turn-nav">
			if turn.Index > 1 {
				<a class="turn-prev" href={ templ.SafeURL(fmt.Sprintf("#turn-%d", turn.Index-1)) }>← prev</a>
			}
			if turn.Index < total {
				<a class="turn-next" href={ templ.SafeURL(fmt.Sprintf("#turn-%d", turn.Index+1)) }>next →</a>
			}
		</nav>
		<nav class="jk-nav">
			if turn.Index > 1 {
				<a accesskey="k" href={ templ.SafeURL(fmt.Sprintf("#turn-%d", turn.Index-1)) }>[K] prev</a>
			}
			if turn.Index < total {
				<a accesskey="j" href={ templ.SafeURL(fmt.Sprintf("#turn-%d", turn.Index+1)) }>[J] next</a>
			}
		</nav>
		for _, msg := range turn.Messages {
			@message(msg, start, theme)
		}
	</section>
}

// message renders a single message with role, timestamp, and content blocks.
templ message(msg parser.Message, start *time.Time, theme string) {
	<div class={ "message", "message-" + msg.Role }>
		<div class="message-header">
			<span class="message-role">{ msg.Role }</span>
			if msg.Timestamp != nil && start != nil {
				if msg.Timestamp.Equal(*start) {
					<time class="message-time">{ msg.Timestamp.UTC().Format("Mon, 02 Jan 2006 15:04:05 UTC") }</time>
				} else {
					<time class="message-time" title={ msg.Timestamp.UTC().Format(time.RFC3339) }>{ relativeTime(*msg.Timestamp, *start) }</time>
				}
			}
		</div>
		<div class="message-body">
			for _, block := range msg.Content {
				@contentBlock(block, theme)
			}
		</div>
	</div>
}

// contentBlock renders a single content block.
templ contentBlock(block parser.ContentBlock, theme string) {
	switch b := block.(type) {
		case *parser.TextBlock:
			<div class="text-block">@templ.Raw(string(renderMarkdown(b.Text, theme)))</div>
		case *parser.ErrorBlock:
			<div class="error-callout">
				<strong>⚠ Parse error on line { fmt.Sprintf("%d", b.LineNum) }:</strong> { b.Msg }
				<details>
					<summary>Raw line</summary>
					<pre class="raw-block">{ string(b.Raw) }</pre>
				</details>
			</div>
		case *parser.ToolResultBlock:
			@toolResultBlock(b)
		case *parser.ToolUseBlock:
			@toolUseBlock(b, theme)
		case *parser.ThinkingBlock:
			@thinkingBlock(b)
		case *parser.RawBlock:
			<pre class="raw-block">[{ b.BlockType() }] { string(b.Data) }</pre>
		default:
			<p class="unknown-block">(unknown block)</p>
	}
}

// toolUseBlock renders a tool_use content block as a collapsible <details> section.
templ toolUseBlock(b *parser.ToolUseBlock, theme string) {
	<details class="collapsible tool-use" style={ fmt.Sprintf("--preview-lines: %d", ToolUsePreviewLines) }>
		<summary>
			<span class="tool-icon">{ toolIcon(b.Name) }</span>
			<span class="tool-name">{ b.Name }</span>
			if arg := toolPrimaryArg(b.Name, b.Input); arg != "" {
				<span class="tool-arg">{ arg }</span>
			}
		</summary>
		<div class="preview-content">
			@templ.Raw(string(toolInputHighlighted(b.Name, b.Input, theme)))
		</div>
	</details>
}

// thinkingBlock renders a thinking content block as a collapsible <details> section.
templ thinkingBlock(b *parser.ThinkingBlock) {
	<details class="collapsible thinking" style={ fmt.Sprintf("--preview-lines: %d", ThinkingPreviewLines) }>
		<summary>Internal reasoning</summary>
		<div class="preview-content">
			<pre class="thinking-content">{ b.Thinking }</pre>
		</div>
	</details>
}

// toolResultBlock renders a tool_result content block as a collapsible <details> section.
// ANSI escape sequences in the content are converted to HTML spans.
templ toolResultBlock(b *parser.ToolResultBlock) {
	<details class="collapsible tool-result" style={ fmt.Sprintf("--preview-lines: %d", ToolResultPreviewLines) }>
		<summary>
			<span class="tool-result-label">output</span>
			if b.Content != "" {
				<span class="tool-result-preview">{ toolResultSummary(b.Content) }</span>
			}
		</summary>
		<div class="preview-content">
			@templ.Raw(string(ansi.Convert(b.Content)))
		</div>
	</details>
}
