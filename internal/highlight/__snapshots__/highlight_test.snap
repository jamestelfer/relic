/* NameDecorator */ .term .chroma .nd { color: #d2a8ff; font-weight: bold }
/* NameEntity */ .term .chroma .ni { color: #ffa657 }
/* NameException */ .term .chroma .ne { color: #f0883e; font-weight: bold }
/* NameLabel */ .term .chroma .nl { color: #79c0ff; font-weight: bold }
/* NameNamespace */ .term .chroma .nn { color: #ff7b72 }
/* NameProperty */ .term .chroma .py { color: #79c0ff }
/* NameTag */ .term .chroma .nt { color: #7ee787 }
/* NameVariable */ .term .chroma .nv { color: #79c0ff }
/* NameVariableClass */ .term .chroma .vc { color: #79c0ff }
/* NameVariableGlobal */ .term .chroma .vg { color: #79c0ff }
/* NameVariableInstance */ .term .chroma .vi { color: #79c0ff }
/* NameVariableMagic */ .term .chroma .vm { color: #79c0ff }
/* NameFunction */ .term .chroma .nf { color: #d2a8ff; font-weight: bold }
/* NameFunctionMagic */ .term .chroma .fm { color: #d2a8ff; font-weight: bold }
/* Literal */ .term .chroma .l { color: #a5d6ff }
/* LiteralDate */ .term .chroma .ld { color: #79c0ff }
/* LiteralString */ .term .chroma .s { color: #a5d6ff }
/* LiteralStringAffix */ .term .chroma .sa { color: #79c0ff }
/* LiteralStringBacktick */ .term .chroma .sb { color: #a5d6ff }
/* LiteralStringChar */ .term .chroma .sc { color: #a5d6ff }
/* LiteralStringDelimiter */ .term .chroma .dl { color: #79c0ff }
/* LiteralStringDoc */ .term .chroma .sd { color: #a5d6ff }
/* LiteralStringDouble */ .term .chroma .s2 { color: #a5d6ff }
/* LiteralStringEscape */ .term .chroma .se { color: #79c0ff }
/* LiteralStringHeredoc */ .term .chroma .sh { color: #79c0ff }
/* LiteralStringInterpol */ .term .chroma .si { color: #a5d6ff }
/* LiteralStringOther */ .term .chroma .sx { color: #a5d6ff }
/* LiteralStringRegex */ .term .chroma .sr { color: #79c0ff }
/* LiteralStringSingle */ .term .chroma .s1 { color: #a5d6ff }
/* LiteralStringSymbol */ .term .chroma .ss { color: #a5d6ff }
/* LiteralNumber */ .term .chroma .m { color: #a5d6ff }
/* LiteralNumberBin */ .term .chroma .mb { color: #a5d6ff }
/* LiteralNumberFloat */ .term .chroma .mf { color: #a5d6ff }
/* LiteralNumberHex */ .term .chroma .mh { color: #a5d6ff }
/* LiteralNumberInteger */ .term .chroma .mi { color: #a5d6ff }
/* LiteralNumberIntegerLong */ .term .chroma .il { color: #a5d6ff }
/* LiteralNumberOct */ .term .chroma .mo { color: #a5d6ff }
/* Operator */ .term .chroma .o { color: #ff7b72; font-weight: bold }
/* OperatorWord */ .term .chroma .ow { color: #ff7b72; font-weight: bold }
/* OperatorReserved */ .term .chroma .or { color: #ff7b72; font-weight: bold }
/* Comment */ .term .chroma .c { color: #8b949e; font-style: italic }
/* CommentHashbang */ .term .chroma .ch { color: #8b949e; font-style: italic }
/* CommentMultiline */ .term .chroma .cm { color: #8b949e; font-style: italic }
/* CommentSingle */ .term .chroma .c1 { color: #8b949e; font-style: italic }
/* CommentSpecial */ .term .chroma .cs { color: #8b949e; font-weight: bold; font-style: italic }
/* CommentPreproc */ .term .chroma .cp { color: #8b949e; font-weight: bold; font-style: italic }
/* CommentPreprocFile */ .term .chroma .cpf { color: #8b949e; font-weight: bold; font-style: italic }
/* GenericDeleted */ .term .chroma .gd { color: #ffa198; background-color: #490202 }
/* GenericEmph */ .term .chroma .ge { font-style: italic }
/* GenericError */ .term .chroma .gr { color: #ffa198 }
/* GenericHeading */ .term .chroma .gh { color: #79c0ff; font-weight: bold }
/* GenericInserted */ .term .chroma .gi { color: #56d364; background-color: #0f5323 }
/* GenericOutput */ .term .chroma .go { color: #8b949e }
/* GenericPrompt */ .term .chroma .gp { color: #8b949e }
/* GenericStrong */ .term .chroma .gs { font-weight: bold }
/* GenericSubheading */ .term .chroma .gu { color: #79c0ff }
/* GenericTraceback */ .term .chroma .gt { color: #ff7b72 }
/* GenericUnderline */ .term .chroma .gl { text-decoration: underline }
/* TextWhitespace */ .term .chroma .w { color: #6e7681 }
.chroma { background-color: var(--bg-code); }
.term .chroma { background-color: transparent; }
.term .chroma .p { color: inherit; }
pre.chroma {
  font-family: var(--font-mono);
  font-size: 0.875rem;
  line-height: 1.5;
  margin: 0;
  padding: 1rem;
  border-radius: 0;
  overflow-x: auto;
}

