            </style><script>
                document.addEventListener('DOMContentLoaded', function() {
                    document.querySelectorAll('pre').forEach(function(pre) {
                        var btn = document.createElement('button');
                        btn.textContent = 'Copy';
                        btn.style.cssText = 'position:absolute;top:0.25rem;right:0.25rem;font-size:0.75em;padding:0.1rem 0.4rem;cursor:pointer;';
                        pre.style.position = 'relative';
                        btn.addEventListener('click', function() {
                            navigator.clipboard.writeText(pre.querySelector('code') ? pre.querySelector('code').innerText : pre.innerText);
                            btn.textContent = 'Copied!';
                            setTimeout(function(){ btn.textContent = 'Copy'; }, 1500);
                        });
                        pre.appendChild(btn);
                    });

                    var turns = Array.from(document.querySelectorAll('section[id^="turn-"]')).map(function(s) { return s.id; });
                    document.addEventListener('keydown', function(e) {
                        if (e.target.matches('input,textarea,select,[contenteditable]')) return;
                        if (e.metaKey || e.ctrlKey || e.altKey) return;
                        var hash = window.location.hash.replace('#', '') || turns[0];
                        var idx = turns.indexOf(hash);
                        if (e.key === 'j' && idx < turns.length - 1) window.location.hash = turns[idx + 1];
                        if (e.key === 'k' && idx > 0) window.location.hash = turns[idx - 1];
                    });
                });
