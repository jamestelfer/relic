                body { font-family: sans-serif; max-width: 900px; margin: 0 auto; padding: 1rem; }
                .session-banner { border-bottom: 2px solid #ccc; margin-bottom: 1.5rem; padding-bottom: 1rem; }
                .session-banner dl { display: grid; grid-template-columns: max-content 1fr; gap: 0.25rem 1rem; }
                section[id^="turn-"] { border-left: 3px solid #e0e0e0; margin: 1rem 0; padding-left: 1rem; }
